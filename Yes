SELECT grantee usuario, 'ROL' tipo, granted_role permiso, NULL objeto
  FROM dba_role_privs
 WHERE grantee IN (SELECT username FROM dba_users WHERE oracle_maintained='N')
UNION ALL
SELECT grantee, 'SISTEMA', privilege, NULL
  FROM dba_sys_privs
 WHERE grantee IN (SELECT username FROM dba_users WHERE oracle_maintained='N')
UNION ALL
SELECT grantee, 'OBJETO', privilege, owner||'.'||table_name
  FROM dba_tab_privs
 WHERE grantee IN (SELECT username FROM dba_users WHERE oracle_maintained='N')
 ORDER BY 1, 2, 3;
