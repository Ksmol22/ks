        <mxCell id="notaProd" value="Cada primaria conecta además a CATDB (1521) para registrar sus backups en el catálogo centralizado&#10;Data Guard Broker (dgmgrl) gestiona switchover, failover y snapshot standby por cada par PRODxx ↔ STBYxx" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#5A657A;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="55" y="672" width="795" height="40" as="geometry" />
        </mxCell>

        <mxCell id="leyenda" value="RPO ≈ segundos (redo en tiempo real)&#9;·&#9;RTO ≈ minutos (failover con broker)&#9;·&#9;Retención de backups: 2 días&#9;·&#9;Carga en producción: mínima" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#3D475C;" vertex="1" parent="1">
          <mxGeometry x="35" y="744" width="830" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leyenda2" value="Flujo verde = transporte de redo hacia el central · Flujo ámbar = restauración / duplicado hacia producción · Flujo morado = backup interno del central" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#5A657A;" vertex="1" parent="1">
          <mxGeometry x="35" y="766" width="830" height="18" as="geometry" />
