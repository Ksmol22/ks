        <mxCell id="firewall" value="&lt;b&gt;FIREWALL — únicamente 1521/tcp (SQL*Net) · cifrado AES256 + checksum SHA512&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5A657A'&gt;22/tcp restringido a la subred de DBAs · sin NFS (2049), sin portmapper (111), sin filesystems compartidos&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDEEEE;strokeColor=#C0504D;strokeWidth=2;dashed=1;dashPattern=8 5;fontSize=11;fontColor=#A33C39;" vertex="1" parent="1">
